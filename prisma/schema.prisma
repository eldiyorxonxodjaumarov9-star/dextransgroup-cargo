generator client {
  provider      = "prisma-client-js"
  // native = build machine; rhel-openssl-3.0.x = Vercel Node serverless runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Warehouse {
  id           String      @id @default(cuid())
  name         String
  region       String
  city         String
  address      String
  phone        String
  telegramUrl  String?
  locationUrl  String?
  country      String?
  province     String?
  district     String?
  receiver     String?
  phone2       String?
  workingHours String?
  notes        String?
  latitude     Float?
  longitude    Float?
  entryType    String      @default("MANUAL")
  pdfUrl       String?
  pdfFileName  String?
  pdfData      Bytes?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        CargoItem[]
  operators    Operator[]
}

model Operator {
  id          String      @id @default(cuid())
  name        String
  phone       String
  telegram    String?
  isActive    Boolean     @default(true)
  warehouseId String?
  warehouse   Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       CargoItem[]
}

model CargoItem {
  id           String     @id @default(cuid())
  name         String
  trackNumber  String     @unique
  imageUrl     String?
  description  String?
  price        String?
  category     String
  status       String
  date         DateTime
  etaDate      DateTime?
  telegramUrl  String?
  locationUrl  String?
  chinaAddress String?
  notes        String?
  entryType    String     @default("MANUAL")
  pdfUrl       String?
  pdfFileName  String?
  pdfData      Bytes?
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  operatorId   String?
  operator     Operator?  @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     TelegramCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  telegramSubscriptions TelegramCargoSubscription[]
  ownershipClaims       CargoOwnershipClaim[]

  @@index([customerId])
}

/// Telegram bot customer profile (phone-verified via Telegram contact share)
model TelegramCustomer {
  id               String   @id @default(cuid())
  telegramUserId   String   @unique
  chatId           String
  firstName        String
  lastName         String?
  username         String?
  phone            String?
  normalizedPhone  String?
  customerCode     String   @unique
  language         String   @default("UZ")
  status           String   @default("PENDING") // PENDING | VERIFIED | BLOCKED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  cargoItems       CargoItem[]
  ownershipClaims  CargoOwnershipClaim[]

  @@index([normalizedPhone])
  @@index([status])
}

/// User request to link a found cargo track to their customer profile
model CargoOwnershipClaim {
  id                 String   @id @default(cuid())
  telegramCustomerId String
  telegramCustomer   TelegramCustomer @relation(fields: [telegramCustomerId], references: [id], onDelete: Cascade)
  cargoItemId        String
  cargoItem          CargoItem @relation(fields: [cargoItemId], references: [id], onDelete: Cascade)
  status             String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt          DateTime @default(now())
  reviewedAt         DateTime?
  reviewedBy         String?

  @@index([status, createdAt])
  @@index([cargoItemId, status])
  @@index([telegramCustomerId, status])
}

/// Durable Telegram conversation state (serverless-safe)
model TelegramBotSession {
  id             String   @id @default(cuid())
  telegramUserId String   @unique
  chatId         String
  mode           String
  step           String?
  payloadJson    String   @default("{}")
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime

  @@index([expiresAt])
}

/// Webhook update deduplication
model TelegramProcessedUpdate {
  updateId    BigInt   @id
  processedAt DateTime @default(now())
}

/// User opt-in for cargo status notifications
model TelegramCargoSubscription {
  id             String    @id @default(cuid())
  telegramUserId String
  chatId         String
  cargoItemId    String
  cargoItem      CargoItem @relation(fields: [cargoItemId], references: [id], onDelete: Cascade)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@unique([telegramUserId, cargoItemId])
  @@index([cargoItemId, isActive])
}

/// Retryable outbound Telegram notifications
model TelegramNotificationEvent {
  id             String    @id @default(cuid())
  type           String
  cargoItemId    String
  subscriptionId String?
  chatId         String
  telegramUserId String
  payloadJson    String
  status         String    @default("PENDING") // PENDING | PROCESSING | SENT | FAILED
  attempts       Int       @default(0)
  lastError      String?
  nextAttemptAt  DateTime  @default(now())
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([cargoItemId])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Mehmon xizmatlari banner / galereya / video (admin yuklaydi)
model GuestServiceMedia {
  id        String   @id @default(cuid())
  kind      String   // BANNER | IMAGE | VIDEO
  title     String?
  sortOrder Int      @default(0)
  mimeType  String?
  fileName  String?
  data      Bytes?
  mediaUrl  String?  // /api/guest-services/{id}/file yoki tashqi URL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
