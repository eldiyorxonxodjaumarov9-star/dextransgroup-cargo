{
  "name": "dextrans-cargo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-with-env.mjs generate && tsx scripts/upsert-admin.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/prisma-with-env.mjs db push",
    "db:migrate": "node scripts/prisma-with-env.mjs migrate deploy",
    "db:seed": "prisma db seed",
    "db:admin": "tsx scripts/upsert-admin.ts",
    "db:reset": "node scripts/prisma-with-env.mjs db push --force-reset && prisma db seed",
    "prisma:generate": "node scripts/prisma-generate-safe.mjs",
    "postinstall": "node scripts/prisma-with-env.mjs generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "prisma": "5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
