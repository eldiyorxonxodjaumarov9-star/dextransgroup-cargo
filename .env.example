# PostgreSQL (Vercel / Neon / Supabase)
# For Neon: pooled URL → DATABASE_URL, direct URL → DIRECT_URL.
# If DIRECT_URL is omitted, the app falls back to DATABASE_URL automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin seed (required in production; hashed with bcrypt — never store plain text in DB)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# Session signing secret (long random string; required in production)
SESSION_SECRET="change-this-to-a-long-random-string"

# Public site URL (optional)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
