# DextransGroup Cargo — environment template
# Copy to .env.local / Vercel. Never commit real secrets.

DATABASE_URL=
DIRECT_URL=
SESSION_SECRET=

# Public site URL (no trailing slash)
APP_URL=https://dextransgroup-cargo.vercel.app

# Telegram Mini App + webhook (leave empty until BotFather setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=600
